<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_notif_card"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <!-- Top Row: Artwork, Title, Artist, Output Switcher -->
    <LinearLayout
        android:id="@+id/notif_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Album Artwork Thumbnail with Rounded Corners -->
        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp">

            <ImageView
                android:id="@+id/notif_album_art"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="Album Art"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_logo" />
        </FrameLayout>

        <!-- Track Title and Artist -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notif_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Track Title"
                android:textColor="#121316"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notif_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Artist Name"
                android:textColor="#6B6E77"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Cast / Audio Output Switcher Icon -->
        <ImageView
            android:id="@+id/notif_btn_cast"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Audio Output"
            android:padding="4dp"
            android:src="@drawable/ic_notif_cast" />
    </LinearLayout>

    <!-- Middle Row: 5 Action Controls (Heart, Prev, Play/Pause, Next, Close) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 1. Favorite / Heart -->
        <ImageView
            android:id="@+id/notif_btn_fav"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Favorite"
            android:padding="7dp"
            android:src="@drawable/ic_notif_heart_outline" />

        <!-- 2. Previous -->
        <ImageView
            android:id="@+id/notif_btn_prev"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Previous"
            android:padding="6dp"
            android:src="@drawable/ic_notif_prev" />

        <!-- 3. Play / Pause -->
        <ImageView
            android:id="@+id/notif_btn_play_pause"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Play/Pause"
            android:padding="5dp"
            android:src="@drawable/ic_notif_play" />

        <!-- 4. Next -->
        <ImageView
            android:id="@+id/notif_btn_next"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Next"
            android:padding="6dp"
            android:src="@drawable/ic_notif_next" />

        <!-- 5. Close / Stop -->
        <ImageView
            android:id="@+id/notif_btn_close"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:padding="8dp"
            android:src="@drawable/ic_notif_close" />
    </LinearLayout>

    <!-- Bottom Row: Current Elapsed Time, Progress Bar, Total Duration -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/notif_time_current"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#7A7D87"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/notif_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="10dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:max="1000"
            android:progress="0"
            android:progressDrawable="@drawable/bg_notif_progress" />

        <TextView
            android:id="@+id/notif_time_total"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="00:00"
            android:textColor="#7A7D87"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
